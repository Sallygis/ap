<?xml version="1.0" encoding="UTF-8"?>

<!-- Defines the shared ticket dashboard, actions, and live notification banner. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-background-color: #f1f5f9; -fx-padding: 20; -fx-font-size: 13px;
             -fx-focus-color: #2563eb; -fx-faint-focus-color: #2563eb30;">

    <VBox spacing="12.0"
          style="-fx-background-color: #142842; -fx-background-radius: 12; -fx-padding: 16 18;">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label fx:id="dashboardTitle" HBox.hgrow="ALWAYS" maxWidth="Infinity" wrapText="true"
                   style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <VBox alignment="CENTER_RIGHT" spacing="4.0">
                <Label fx:id="accountName" wrapText="true" maxWidth="220.0" textAlignment="RIGHT"
                       style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="accountRole"
                       style="-fx-background-color: #294665; -fx-background-radius: 10;
                              -fx-padding: 3 9; -fx-text-fill: #e0edff; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <FlowPane alignment="CENTER_RIGHT" hgap="8.0" vgap="8.0">
            <Button fx:id="manageAccountsButton" text="Manage accounts" onAction="#manageAccounts"
                    style="-fx-base: #294665; -fx-text-fill: white; -fx-padding: 6 12;"/>
            <Button fx:id="reportsButton" text="Reports" onAction="#openReports"
                    style="-fx-base: #294665; -fx-text-fill: white; -fx-padding: 6 12;"/>
            <Button fx:id="changePasswordButton" text="Change password" onAction="#changePassword"
                    style="-fx-base: #294665; -fx-text-fill: white; -fx-padding: 6 12;"/>
            <Button text="Sign out" onAction="#logout"
                    style="-fx-base: #f8fafc; -fx-text-fill: #142842; -fx-padding: 6 12;"/>
        </FlowPane>
    </VBox>

    <VBox spacing="12.0" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #dce5ef;
                 -fx-border-radius: 12; -fx-padding: 14;">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <TextField fx:id="searchField" promptText="Search by ticket ID or subject"
                       accessibleText="Search tickets" HBox.hgrow="ALWAYS" minWidth="120.0"
                       style="-fx-control-inner-background: #f8fafc; -fx-prompt-text-fill: #52647a;
                              -fx-padding: 8 10;"/>
            <Button text="Refresh" onAction="#refreshTickets"
                    style="-fx-base: #eef3f9; -fx-text-fill: #243850; -fx-padding: 8 12;"/>
            <Button fx:id="openTicketButton" text="Open ticket" onAction="#openSelectedTicket"
                    style="-fx-base: #eef3f9; -fx-text-fill: #243850; -fx-padding: 8 12;"/>
            <Button fx:id="ticketAction" onAction="#handleTicketAction"
                    style="-fx-base: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 8 14;"/>
        </HBox>

        <Label fx:id="notificationMessage" text="" visible="false" managed="false" wrapText="true"
               maxWidth="Infinity"
               style="-fx-background-color: #eaf3ff; -fx-background-radius: 7; -fx-padding: 9 12;
                      -fx-text-fill: #173e78;"/>

        <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS"
                   style="-fx-base: #eaf0f7; -fx-control-inner-background: white;
                          -fx-control-inner-background-alt: #f7faff; -fx-selection-bar: #1d4ed8;
                          -fx-selection-bar-non-focused: #dbeafe; -fx-table-cell-border-color: #edf2f7;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="idColumn" text="ID" minWidth="55.0" maxWidth="90.0"/>
                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="300.0"/>
                <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="130.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="140.0"/>
                <TableColumn fx:id="technicianColumn" text="Technician" prefWidth="170.0"/>
            </columns>
            <placeholder>
                <Label text="No tickets found" style="-fx-text-fill: #52647a;"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
