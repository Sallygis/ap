<?xml version="1.0" encoding="UTF-8"?>
<!-- Defines the Student and Staff registration form. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <Label text="Create an account" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
    <VBox spacing="8.0" maxWidth="340.0">
        <Label text="Full name"/>
        <TextField fx:id="fullNameField" accessibleText="Full name"/>
        <Label text="Email"/>
        <TextField fx:id="emailField" accessibleText="Email"/>
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" accessibleText="Password"/>
        <Label text="Account type"/>
        <ComboBox fx:id="requesterKindSelector" promptText="Select Student or Staff"
                  accessibleText="Account type" maxWidth="Infinity"/>
        <Button text="Register" onAction="#register" defaultButton="true" maxWidth="Infinity"/>
        <Label fx:id="formMessage" wrapText="true"/>
    </VBox>
    <Hyperlink text="Back to sign in" onAction="#showLogin"/>
</VBox>
