<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           style="-fx-padding: 28; -fx-background-color: #EDF0F8;">
    <VBox spacing="10" maxWidth="360" maxHeight="-Infinity"
          style="-fx-padding: 28; -fx-background-color: white; -fx-background-radius: 14;">

        <Label text="Reset your password"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Label text="Full name"/>
        <TextField fx:id="fullNameField" promptText="Name used at registration"/>

        <Label text="Email"/>
        <TextField fx:id="emailField" promptText="you@example.com"/>

        <Label text="New password"/>
        <PasswordField fx:id="passwordField" promptText="At least 8 characters"/>

        <Button text="Reset password" onAction="#recoverPassword"
                defaultButton="true" maxWidth="Infinity"/>

        <Label fx:id="formMessage" wrapText="true"/>
        <Hyperlink text="Back to sign in" onAction="#showLogin"/>
    </VBox>
</StackPane>
