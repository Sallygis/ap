<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml/1"
      style="-fx-padding: 20;
             -fx-background-color: linear-gradient(to bottom right,
                 #F8F9FD 0%, #EDF0F8 74%, #DCE5F7 100%);">

    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-padding: 14 18;
                 -fx-background-radius: 14;
                 -fx-background-color: linear-gradient(to bottom right,
                     #AD367F 0%, #38226D 28%, #201842 66%, #106183 100%);">
        <Label text="Reports"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to tickets" onAction="#backToTickets"
                style="-fx-base: #EDE7F7; -fx-background-radius: 16;
                       -fx-padding: 7 14; -fx-text-fill: #382365; -fx-cursor: hand;"/>
    </HBox>

    <VBox spacing="8"
          style="-fx-padding: 10 14; -fx-background-color: white;
                 -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                 -fx-border-radius: 12;">
        <Label text="Ticket summary dates (UTC)"
               style="-fx-text-fill: #382365; -fx-font-weight: bold;"/>
        <HBox fx:id="reportFilters" alignment="CENTER_LEFT" spacing="9">
            <Label text="From" style="-fx-text-fill: #352D4D;"/>
            <DatePicker fx:id="fromDate" editable="false" accessibleText="Start date"
                        prefWidth="140" style="-fx-base: #F3F1F8;"/>
            <Label text="To" style="-fx-text-fill: #352D4D;"/>
            <DatePicker fx:id="toDate" editable="false" accessibleText="End date"
                        prefWidth="140" style="-fx-base: #F3F1F8;"/>
            <Button text="Refresh" onAction="#refreshReports"
                    style="-fx-base: #382365; -fx-background-radius: 14;
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Clear dates" onAction="#clearDates"
                    style="-fx-base: #EDE7F7; -fx-background-radius: 14;
                           -fx-text-fill: #382365; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <GridPane fx:id="reportMetrics" hgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>

        <VBox spacing="5" GridPane.columnIndex="0"
              style="-fx-padding: 9 10; -fx-background-color: white;
                     -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                     -fx-border-radius: 12;">
            <Button text="Tickets submitted" onAction="#showSubmitted" maxWidth="Infinity"
                    style="-fx-base: #EEE7F8; -fx-background-radius: 8;
                           -fx-text-fill: #452878; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label fx:id="submittedTotal"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #452878;"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1"
              style="-fx-padding: 9 10; -fx-background-color: white;
                     -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                     -fx-border-radius: 12;">
            <Button text="Tickets resolved" onAction="#showResolved" maxWidth="Infinity"
                    style="-fx-base: #E1F2F7; -fx-background-radius: 8;
                           -fx-text-fill: #15546A; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label fx:id="resolvedTotal"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #15546A;"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="2"
              style="-fx-padding: 9 10; -fx-background-color: white;
                     -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                     -fx-border-radius: 12;">
            <Button text="Open tickets" onAction="#showOpen" maxWidth="Infinity"
                    style="-fx-base: #F8E5F0; -fx-background-radius: 8;
                           -fx-text-fill: #84275C; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label fx:id="openTotal"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #84275C;"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="3"
              style="-fx-padding: 9 10; -fx-background-color: white;
                     -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                     -fx-border-radius: 12;">
            <Button text="Average resolution" onAction="#showResolutionTimes" maxWidth="Infinity"
                    style="-fx-base: #E8ECFA; -fx-background-radius: 8;
                           -fx-text-fill: #2C3C76; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Label fx:id="averageResolution"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3C76;"/>
        </VBox>
    </GridPane>

    <Label fx:id="reportMessage" wrapText="true" managed="false" visible="false"
           maxWidth="Infinity"
           style="-fx-padding: 7 10; -fx-background-color: #F8E5F0;
                  -fx-background-radius: 8; -fx-text-fill: #84275C;"/>

    <VBox spacing="8" VBox.vgrow="ALWAYS"
          style="-fx-padding: 10 12; -fx-background-color: white;
                 -fx-background-radius: 12; -fx-border-color: #E3DDEE;
                 -fx-border-radius: 12;">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="tableTitle"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #211B3A;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="workloadButton" text="Technician workload" onAction="#showWorkload"
                    style="-fx-base: #EDE7F7; -fx-background-radius: 14;
                           -fx-text-fill: #382365; -fx-cursor: hand;"/>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="workloadTable"
                       style="-fx-base: #F3EFF8; -fx-control-inner-background: white;
                              -fx-control-inner-background-alt: #F8F6FB;
                              -fx-selection-bar: #382365; -fx-border-color: #E3DDEE;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="technicianColumn" text="Technician" prefWidth="500"/>
                    <TableColumn fx:id="assignmentColumn" text="Open assignments" prefWidth="170"/>
                </columns>
                <placeholder>
                    <Label fx:id="workloadPlaceholder" text="No technician accounts found"
                           style="-fx-text-fill: #605184;"/>
                </placeholder>
            </TableView>

            <TableView fx:id="reportTickets"
                       style="-fx-base: #F3EFF8; -fx-control-inner-background: white;
                              -fx-control-inner-background-alt: #F8F6FB;
                              -fx-selection-bar: #382365; -fx-border-color: #E3DDEE;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="ticketIdColumn" text="ID" minWidth="55" maxWidth="90"/>
                    <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="320"/>
                    <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="125"/>
                    <TableColumn fx:id="resolutionColumn" text="Resolution time" prefWidth="150"/>
                </columns>
                <placeholder>
                    <Label fx:id="ticketsPlaceholder" text="No tickets match this report"
                           style="-fx-text-fill: #605184;"/>
                </placeholder>
            </TableView>
        </StackPane>
    </VBox>
</VBox>
