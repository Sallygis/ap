<?xml version="1.0" encoding="UTF-8"?>
<!-- Defines administrator summary buttons and the switchable report tables. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Reports" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to tickets" onAction="#backToTickets"/>
    </HBox>
    <Label text="Ticket summary dates (UTC)"/>
    <HBox fx:id="reportFilters" alignment="CENTER_LEFT" spacing="9.0">
        <Label text="From"/>
        <DatePicker fx:id="fromDate" editable="false" accessibleText="Start date"/>
        <Label text="To"/>
        <DatePicker fx:id="toDate" editable="false" accessibleText="End date"/>
        <Button text="Refresh" onAction="#refreshReports"/>
        <Button text="Clear dates" onAction="#clearDates"/>
    </HBox>
    <GridPane fx:id="reportMetrics" hgap="12.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
            <ColumnConstraints percentWidth="25.0"/>
        </columnConstraints>
        <VBox spacing="5.0" GridPane.columnIndex="0">
            <Button text="Tickets submitted" onAction="#showSubmitted"/>
            <Label fx:id="submittedTotal" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="1">
            <Button text="Tickets resolved" onAction="#showResolved"/>
            <Label fx:id="resolvedTotal" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="2">
            <Button text="Open tickets" onAction="#showOpen"/>
            <Label fx:id="openTotal" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="5.0" GridPane.columnIndex="3">
            <Button text="Average resolution" onAction="#showResolutionTimes"/>
            <Label fx:id="averageResolution" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
    </GridPane>
    <Label fx:id="reportMessage" wrapText="true" managed="false" visible="false"/>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label fx:id="tableTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="workloadButton" text="Technician workload" onAction="#showWorkload"/>
    </HBox>
    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="workloadTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="technicianColumn" text="Technician" prefWidth="500.0"/>
                <TableColumn fx:id="assignmentColumn" text="Open assignments" prefWidth="170.0"/>
            </columns>
            <placeholder>
                <Label fx:id="workloadPlaceholder" text="No technician accounts found"/>
            </placeholder>
        </TableView>
        <TableView fx:id="reportTickets">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="ticketIdColumn" text="ID" minWidth="55.0" maxWidth="90.0"/>
                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="320.0"/>
                <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="100.0"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="125.0"/>
                <TableColumn fx:id="resolutionColumn" text="Resolution time" prefWidth="150.0"/>
            </columns>
            <placeholder>
                <Label fx:id="ticketsPlaceholder" text="No tickets match this report"/>
            </placeholder>
        </TableView>
    </StackPane>
</VBox>
